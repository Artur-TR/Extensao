{
  "manifest_version": 3,
  "name": "Registro de Nao Atendimento",
  "version": "0.5.0",
  "description": "Registra o motivo de chamadas nao atendidas, mantem historico local e envia para a lista do SharePoint.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://sgd.dominiosistemas.com.br/*",
    "https://trten-my.sharepoint.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Registrar nao atendimento"
  }
}
